<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_brand_origin" model="ir.ui.view">
        <field name="name">product.template.form.brand.origin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id"/>
                <field name="country_of_origin_id" options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>
</odoo>
