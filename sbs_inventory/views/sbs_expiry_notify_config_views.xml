<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbs_expiry_notify_config_list" model="ir.ui.view">
        <field name="name">sbs.expiry.notify.config.list</field>
        <field name="model">sbs.expiry.notify.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" options="{'no_create': True}"/>
                <field name="days_before"/>
                <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_sbs_expiry_notify_config_form" model="ir.ui.view">
        <field name="name">sbs.expiry.notify.config.form</field>
        <field name="model">sbs.expiry.notify.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="days_before"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sbs_expiry_notify_config" model="ir.actions.act_window">
        <field name="name">Expiry Notify Configuration</field>
        <field name="res_model">sbs.expiry.notify.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Choose who is told before a lot expires.
            </p>
            <p>
                Set the company or branch, how many days before the lot expiry date, and the people to notify.
                Add one row for each company and one row for each branch. A branch is a company with a parent.
                A daily check looks at stock in that company or branch only, and notifies those people once for each lot still in stock.
                A branch uses products and lots of its parent company. 1 day means the day before expiry.
            </p>
        </field>
    </record>

    <menuitem id="menu_sbs_expiry_notify_config"
              name="Expiry Notify Configuration"
              parent="stock.menu_stock_config_settings"
              action="action_sbs_expiry_notify_config"
              groups="stock.group_stock_manager"
              sequence="60"/>
</odoo>
