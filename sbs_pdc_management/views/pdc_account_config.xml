<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_pdc_configuration" model="ir.ui.view">
        <field name="name">res.company.form.pdc.configuration</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="PDC Configuration" name="pdc_configuration">
                    <group>
                        <field name="pdc_receivable_account_id"/>
                        <field name="pdc_payable_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
